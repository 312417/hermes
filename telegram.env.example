# Copy to /home/hermes/.config/hermes/telegram.env on the phone.
# Never commit the real file or the bot token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_PAIRING_CODE=replace-with-a-long-random-code
# Optional after pairing; comma-separated Telegram chat IDs.
TELEGRAM_ALLOWED_CHAT_IDS=
HERMES_TIMEZONE=America/Sao_Paulo
HERMES_ACTIVE_CONTEXT_MESSAGES=24
HERMES_MEMORY_MESSAGES_PER_CHAT=500

# Model adapter. Keep the real key only in the phone's private env file.
HERMES_MODEL_PROVIDER=groq
GROQ_API_KEY=
# Local routing defaults. Use #fast, #text, #think or #research to override.
HERMES_FAST_MODEL=openai/gpt-oss-20b
HERMES_TEXT_MODEL=llama-3.3-70b-versatile
HERMES_THINK_MODEL=openai/gpt-oss-120b
HERMES_RESEARCH_MODEL=groq/compound
