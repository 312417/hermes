#!/data/data/com.termux/files/usr/bin/sh
# start-hermes — Executado pelo Termux:Boot na inicialização do celular (Samsung S20 FE).
# Mantém o OpenCodex e o Hermes Agent Gateway rodando 100% localmente no aparelho.

termux-wake-lock
unset LD_PRELOAD
pgrep -x sshd >/dev/null 2>&1 || sshd

# Sincronizar segredos do Termux para o container Ubuntu se existirem
if [ -f "$HOME/.hermes/.env" ]; then
  env -u LD_PRELOAD proot-distro login ubuntu -- env -u LD_PRELOAD bash -c 'mkdir -p /root/.hermes && cp /data/data/com.termux/files/home/.hermes/.env /root/.hermes/.env && chmod 600 /root/.hermes/.env'
fi

# Garantir que o OpenCodex local está rodando no S20 FE
ensure_opencodex() {
  if ! curl -s -m 2 http://127.0.0.1:10100/healthz >/dev/null 2>&1; then
    echo "[$(date)] Iniciando OpenCodex local no S20 FE..." >> "$HOME/hermes-gateway.log"
    env -u LD_PRELOAD proot-distro login ubuntu -- env -u LD_PRELOAD bash -lc 'nohup ocx start >/root/.opencodex/ocx.log 2>&1 &'
    sleep 3
  fi
}

while true; do
  ensure_opencodex
  env -u LD_PRELOAD proot-distro login ubuntu -- env -u LD_PRELOAD bash -lc \
    'export HERMES_TIMEZONE="America/Sao_Paulo"; [ -f /root/.hermes/.env ] && set -a && . /root/.hermes/.env && set +a; cd /root/hermes-agent && exec /usr/local/bin/hermes gateway run' \
    >> "$HOME/hermes-gateway.log" 2>&1
  echo "[$(date)] Hermes Gateway encerrou, reiniciando em 5s..." >> "$HOME/hermes-gateway.log"
  sleep 5
done
