#!/data/data/com.termux/files/usr/bin/sh
# start-hermes — Executado pelo Termux:Boot na inicialização do celular (Samsung S20 FE).
# Inicia e supervisiona a pilha runit de alta disponibilidade localmente.

termux-wake-lock
unset LD_PRELOAD
PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
HOME="${HOME:-/data/data/com.termux/files/home}"
export SVDIR="${SVDIR:-$PREFIX/var/service}"
export LOGDIR="${LOGDIR:-$PREFIX/var/log}"
LOG_FILE="$HOME/supervisor-boot.log"

echo "[$(date -Iseconds)] [BOOT] Termux:Boot inicializado no S20 FE." >> "$LOG_FILE"

# Garantir que o sshd está ativo
pgrep -x sshd >/dev/null 2>&1 || sshd

# Sincronizar segredos do Termux para o container Ubuntu se existirem
if [ -f "$HOME/.hermes/.env" ]; then
  env -u LD_PRELOAD proot-distro login ubuntu -- env -u LD_PRELOAD bash -c '
    mkdir -p /root/.hermes
    cp /data/data/com.termux/files/home/.hermes/.env /root/.hermes/.env
    chmod 600 /root/.hermes/.env
  '
fi

# Loop de supervisão de primeira camada: mantém o runsvdir ativo
while true; do
  if ! pgrep -f "runsvdir.*service" >/dev/null 2>&1; then
    echo "[$(date -Iseconds)] [BOOT] Iniciando service-daemon (runit)..." >> "$LOG_FILE"
    service-daemon start >> "$LOG_FILE" 2>&1 || true
  fi
  sleep 15
done
